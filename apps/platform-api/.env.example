# platform-api — local env reference. In practice these are injected by Doppler:
#   doppler run --project hq-government-contracted --config prd -- pnpm dev
#
# Canonical names below. The BFF also accepts the platform-app names as a fallback
# (NEXT_PUBLIC_GC_SUPABASE_URL, CATALYST_API_URL, CATALYST_API_TOKEN), so it boots
# against the existing platform-app Doppler config with no new keys.

# Supabase project that issues the app's ES256 access tokens. Issuer + JWKS are
# derived from this single URL (…/auth/v1 and …/auth/v1/.well-known/jwks.json).
GC_SUPABASE_URL=https://htgfjmjuzcqffdzuiphg.supabase.co

# core-x catalyst_api (Gen-3 read gateway). In prd point at the PRIVATE Railway
# address so core-x is never exposed publicly:
#   COREX_API_URL=http://catalyst-api.railway.internal:8080
COREX_API_URL=https://<catalyst-api-public-or-internal-host>

# Operator token presented to core-x as Bearer (matches core-x's CATALYST_API_TOKEN).
COREX_SERVICE_TOKEN=<core-x operator token>

# CORS allow-list (comma-separated). prd must include the SPA origin.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001

APP_ENV=dev

# PORT is injected by Railway in deploy; defaults to 8000 locally.
# PORT=8000
